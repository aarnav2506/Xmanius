# Used only by the separate Xmanius general-AI backend.
XMANIUS_GEMINI_API_KEY=
XMANIUS_GEMINI_MODEL=gemini-3.6-flash
XMANIUS_GEMINI_FALLBACK_MODEL=gemini-2.5-flash
XMANIUS_GEMINI_API_KEY_2=
XMANIUS_GEMINI_MODEL_2=gemini-3.6-flash
XMANIUS_GEMINI_API_KEY_3=
XMANIUS_GEMINI_MODEL_3=gemini-3.6-flash
XMANIUS_GEMINI_API_KEY_4=
XMANIUS_GEMINI_MODEL_4=gemini-3.6-flash
XMANIUS_GEMINI_API_KEY_5=
XMANIUS_GEMINI_MODEL_5=gemini-3.6-flash
XMANIUS_GEMINI_API_KEY_6=
XMANIUS_GEMINI_MODEL_6=gemini-3.6-flash
XMANIUS_GEMINI_API_KEY_7=
XMANIUS_GEMINI_MODEL_7=gemini-3.6-flash
# Optional server-side Google Programmable Search integration for the Web button.
# The Google API requires both a key and a Programmable Search Engine ID (cx).
XMANIUS_GOOGLE_SEARCH_API_KEY=
XMANIUS_GOOGLE_SEARCH_CX=
# Optional Google Cloud key with YouTube Data API v3 enabled. If omitted, the
# Google search key is reused for YouTube searches.
XMANIUS_YOUTUBE_API_KEY=
