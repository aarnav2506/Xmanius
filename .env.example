# XManius Slot-Specific Primary Models & Exactly 8 API Keys Architecture
# Slot 1 (XManius 1.5): Gemini 3.5 Flash Lite
XMANIUS_GEMINI_MODEL_1=gemini-3.5-flash-lite
XMANIUS_GEMINI_API_KEY_1=

# Slot 2 (XManius Flash): Gemini 3.1 Flash Lite
XMANIUS_GEMINI_MODEL_2=gemini-3.1-flash-lite
XMANIUS_GEMINI_API_KEY_2=

# Slot 3 (XManius 2 Pro): Gemini 3.8 Flash
XMANIUS_GEMINI_MODEL_3=gemini-3.8-flash
XMANIUS_GEMINI_API_KEY_3=

# Slot 4 (XManius Cortex): Anti-Gravity
XMANIUS_GEMINI_MODEL_4=anti-gravity
XMANIUS_GEMINI_API_KEY_4=

# Multi-Key Pool (Keys 5, 6, 7)
XMANIUS_GEMINI_API_KEY_5=
XMANIUS_GEMINI_API_KEY_6=
XMANIUS_GEMINI_API_KEY_7=

# Key 8: Dedicated EXCLUSIVELY for Voice, Audio, Transcribe & Translate
# (Never drained by text chat; preserves full quota for spoken dialogue & speech-to-text)
XMANIUS_GEMINI_API_KEY_8=
XMANIUS_GEMINI_API_KEY_LIVE=

# Primary Global Fallback Key
XMANIUS_GEMINI_API_KEY=
XMANIUS_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional server-side Google Programmable Search integration for the Web button
XMANIUS_GOOGLE_SEARCH_API_KEY=
XMANIUS_GOOGLE_SEARCH_CX=

# Optional Google Cloud key with YouTube Data API v3 enabled
XMANIUS_YOUTUBE_API_KEY=
